{
  "name": "test-pi-durable",
  "version": "1.0.0",
  "description": "Pi chat agent using pi-durable and Hono",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.5.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@earendil-works/chord": "^1.0.2",
    "@earendil-works/pi-ai": "^1.0.2",
    "@earendil-works/pi-durable": "^1.0.2",
    "@hono/node-server": "^2.1.3",
    "ai": "^7.0.136",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
